				"[concat(variables('factoryId'), '/dataflows/DF_Load_Dim_Benchmark')]",
				"[concat(variables('factoryId'), '/dataflows/DF_Load_Dim_Clients')]",
				"[concat(variables('factoryId'), '/dataflows/DF_Load_Dim_Security')]"
			]
		}
