{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "wealthanalytics-adf"
		},
		"LS_BlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_BlobStorage'"
		},
		"LS_WealthDWH_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_WealthDWH'"
		},
		"LS_WealthStaging_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_WealthStaging'"
		},
		"LS_WealthDWH_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "wealthanalytics-sql-server.database.windows.net"
		},
		"LS_WealthDWH_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "WealthDWH"
		},
		"LS_WealthDWH_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminuser"
		},
		"LS_WealthStaging_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "wealthanalytics-sql-server.database.windows.net"
		},
		"LS_WealthStaging_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "WealthStaging"
		},
		"LS_WealthStaging_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminuser"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_BlobStorage')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('LS_BlobStorage_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_WealthDWH')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_WealthDWH_properties_typeProperties_server')]",
					"database": "[parameters('LS_WealthDWH_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_WealthDWH_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_WealthDWH_password')]"
					}
				}
			},
			"dependsOn": []
		},
