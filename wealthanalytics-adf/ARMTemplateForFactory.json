	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "wealthanalytics-adf"
		},
		"LS_BlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_BlobStorage'"
		},
		"LS_WealthDWH_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_WealthDWH'"
		},
		"LS_WealthStaging_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_WealthStaging'"
		},
		"LS_WealthDWH_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "wealthanalytics-sql-server.database.windows.net"
		},
		"LS_WealthDWH_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "WealthDWH"
		},
		"LS_WealthDWH_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminuser"
		},
		"LS_WealthStaging_properties_typeProperties_server": {
